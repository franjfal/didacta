// Los datos de la aplicación para macOS.
//
// Editado a mano y versionado: la plantilla de `flutter create` pone el
// nombre del paquete de Dart --`didacta_app`-- y eso es lo que sale en la
// barra de menú, en el Dock y en «Acerca de». Un icono bien hecho al lado de
// un nombre que dice `didacta_app` no acaba de estar terminado.

// El nombre de la aplicación, y el título de la ventana.
PRODUCT_NAME = Didacta

// El identificador del paquete: el dominio de la web de Didacta,
// franjfal.github.io, al revés. Es la convención de Apple y la de Linux, y lo
// que lo hace único: ese dominio sólo lo tiene quien publica Didacta.
//
// Fue `es.uv.didacta` hasta la 0.2.0. Los ajustes guardados con el nombre
// anterior los trae `MainFlutterWindow.swift` la primera vez que arranca con
// este, y las plantillas del programa, `legacy_identity_io.dart`.
PRODUCT_BUNDLE_IDENTIFIER = io.github.franjfal.didacta

PRODUCT_COPYRIGHT = Copyright © 2026 Javier Falcó. Todos los derechos reservados.
