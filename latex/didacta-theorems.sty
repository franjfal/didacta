%%
%% didacta-theorems.sty -- theorem-like environments.
%%
%% One set of environment names, two visual treatments chosen by medium:
%%
%%   slides    a boxed environment with a raised title tab: tinted fill,
%%             coloured frame and a short shadow. Has to read from the back of
%%             a lecture theatre, so it is high contrast and compact.
%%   document  the same box, quieter: a much lighter tint and no shadow. Has
%%             to read for an hour on paper, and it breaks across pages.
%%
%% The author's material distinguishes these with two separate template files
%% and two separate environment name sets (`ndefn` boxed vs `defn` plain),
%% which means content has to know which output it is heading for. Didacta uses
%% one name set and switches the rendering, so content does not.
%%
%% All names come from the loaded language file, so a definition is a
%% "Definición", a "Definició" or a "Definition" without the content changing.
%%
%% Built on tcolorbox alone. The legacy system needed the non-CTAN
%% boiboites.sty for \newboxedtheorem; nothing here is outside CTAN.
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{didacta-theorems}[2026/09/09 v1.0 Didacta theorem environments]

\RequirePackage{etoolbox}
\RequirePackage{amsmath}
\RequirePackage{amsthm}
\RequirePackage[many]{tcolorbox}
\tcbuselibrary{skins,breakable}

\makeatletter

%% ---------------------------------------------------------------------------
%% Numbering
%%
%% One shared counter, so Theorem 2.3 is not followed by Definition 2.1 --
%% which is what independent counters produce and what confuses a reader
%% following a cross-reference.
%% ---------------------------------------------------------------------------

\newcounter{didactathm}
\@addtoreset{didactathm}{section}
\renewcommand{\thedidactathm}{%
  \ifnum\c@section>0 \thesection.\fi\arabic{didactathm}}

%% ---------------------------------------------------------------------------
%% \DidactaNewTheorem{env}{name macro}{accent colour}[numbered]
%%
%% Declares one environment in both visual styles at once.
%%   env           the environment name authors type
%%   name macro    e.g. \didactaTheoremName, from the language file
%%   accent        the colour of the rule or title bar
%% ---------------------------------------------------------------------------

\newcommand{\DidactaNewTheorem}[3]{%
  \newenvironment{#1}[1][]{%
    \iftoggle{didacta@slides}%
      {\didacta@thm@slide{#2}{#3}{##1}}%
      {\didacta@thm@doc{#2}{#3}{##1}}%
  }{%
    \iftoggle{didacta@slides}%
      {\didacta@thm@slide@end}%
      {\didacta@thm@doc@end}%
  }%
  %% Starred form: same look, no number. For a restatement or an aside.
  \newenvironment{#1*}[1][]{%
    \iftoggle{didacta@slides}%
      {\didacta@thm@slide@plain{#2}{#3}{##1}}%
      {\didacta@thm@doc@plain{#2}{#3}{##1}}%
  }{%
    \iftoggle{didacta@slides}%
      {\didacta@thm@slide@end}%
      {\didacta@thm@doc@end}%
  }%
}

%% ---------------------------------------------------------------------------
%% La forma de la caja
%%
%% Las dos versiones --pantalla y papel-- son la misma caja con distinta
%% intensidad: marco redondeado, fondo teñido y el título en una **pestaña**
%% que monta sobre el borde superior, desplazada a la izquierda.
%%
%% Esa pestaña es lo que el material heredado tenía y lo que se había perdido
%% al migrar. `boiboites.sty` la dibujaba a mano con dos nodos de TikZ (uno
%% para la caja, otro anclado en `box.north west`); `tcolorbox` la trae hecha
%% en `attach boxed title to top left`, con la ventaja de que la caja sigue
%% siendo `breakable` y se parte entre páginas, cosa que la de TikZ no hacía
%% --un teorema largo se salía del papel.
%%
%% El desplazamiento vertical es medio alto de pestaña: así queda mitad dentro
%% y mitad fuera, que es lo que hace que se lea como una etiqueta cosida a la
%% caja y no como otra caja encima. El `top` de la caja reserva ese medio alto
%% para que la primera línea del texto no se meta debajo del título.
%%
%% El tono del marco (`!55!black`) y el del título (`!25!black`) salen del
%% color del entorno, no de una lista aparte: añadir un entorno nuevo es
%% elegir un color y nada más.
%% ---------------------------------------------------------------------------

\tcbset{
  %% Papel: teñido muy flojo. La página lleva muchas cajas seguidas y un
  %% fondo saturado la convierte en un cartel.
  didacta@thm@paper/.style={
    enhanced, breakable,
    colback=#1!4, colframe=#1!55!black,
    boxrule=0.7pt, arc=3pt,
    left=1em, right=1em, top=1.6ex, bottom=1.1ex,
    before skip=3.2ex, after skip=2.4ex,
    fonttitle=\bfseries, coltitle=#1!25!black,
    attach boxed title to top left={xshift=1.1em, yshift=-\tcboxedtitleheight/2},
    boxed title style={
      enhanced, size=small, arc=2.5pt, boxrule=0.7pt,
      colback=#1!15, colframe=#1!55!black,
    },
  },
  %% Pantalla: más contraste y una sombra corta. Se ve desde el fondo del
  %% aula, que es el único criterio que cuenta aquí.
  didacta@thm@screen/.style={
    enhanced, breakable,
    colback=#1!7, colframe=#1!55!black,
    boxrule=0.8pt, arc=3pt,
    drop fuzzy shadow=black!12,
    left=1em, right=1em, top=1.5ex, bottom=1ex,
    before skip=2.6ex, after skip=2ex,
    fonttitle=\bfseries, coltitle=#1!20!black,
    attach boxed title to top left={xshift=1em, yshift=-\tcboxedtitleheight/2},
    boxed title style={
      enhanced, size=small, arc=2.5pt, boxrule=0.8pt,
      colback=#1!22, colframe=#1!55!black,
    },
  },
}

%% El estilo que corresponde al medio de esta compilación, con un solo nombre.
%%
%% Lo usan también las cajas que no son teoremas --las notas del profesor, los
%% objetivos de la unidad-- y por eso vive aquí y no dentro de cada una: una
%% página donde el teorema lleva pestaña y la nota didáctica lleva otra cosa
%% se lee como dos documentos pegados.
\iftoggle{didacta@slides}%
  {\tcbset{didacta@box/.style={didacta@thm@screen=#1}}}%
  {\tcbset{didacta@box/.style={didacta@thm@paper=#1}}}

%% ---------------------------------------------------------------------------
%% Slide rendering
%% ---------------------------------------------------------------------------

\newcommand{\didacta@thm@slide}[3]{%
  \refstepcounter{didactathm}%
  \begin{tcolorbox}[didacta@thm@screen=#2,
    title={#1~\thedidactathm\ifblank{#3}{}{\ \textnormal{(#3)}}},
  ]%
}
\newcommand{\didacta@thm@slide@plain}[3]{%
  \begin{tcolorbox}[didacta@thm@screen=#2,
    title={#1\ifblank{#3}{}{\ \textnormal{(#3)}}},
  ]%
}
\newcommand{\didacta@thm@slide@end}{\end{tcolorbox}}

%% ---------------------------------------------------------------------------
%% Document rendering: the same box, quieter, and it breaks across pages.
%% ---------------------------------------------------------------------------

\newcommand{\didacta@thm@doc}[3]{%
  \refstepcounter{didactathm}%
  \begin{tcolorbox}[didacta@thm@paper=#2,
    title={#1~\thedidactathm\ifblank{#3}{}{\ \textnormal{(#3)}}},
  ]%
}
\newcommand{\didacta@thm@doc@plain}[3]{%
  \begin{tcolorbox}[didacta@thm@paper=#2,
    title={#1\ifblank{#3}{}{\ \textnormal{(#3)}}},
  ]%
}
\newcommand{\didacta@thm@doc@end}{\end{tcolorbox}}

%% ---------------------------------------------------------------------------
%% The environment set
%%
%% Colour carries meaning and stays constant across every output, so a reader
%% learns "blue means a theorem" once. Names are deferred to the language file.
%% ---------------------------------------------------------------------------

\AtBeginDocument{}

\newcommand{\DidactaDeclareTheorems}{%
  \DidactaNewTheorem{theorem}{\didactaTheoremName}{didactaThm}%
  \DidactaNewTheorem{definition}{\didactaDefinitionName}{didactaDefn}%
  \DidactaNewTheorem{proposition}{\didactaPropositionName}{didactaProp}%
  \DidactaNewTheorem{lemma}{\didactaLemmaName}{didactaLem}%
  \DidactaNewTheorem{corollary}{\didactaCorollaryName}{didactaCor}%
  \DidactaNewTheorem{property}{\didactaPropertyName}{didactaProp}%
  \DidactaNewTheorem{example}{\didactaExampleName}{didactaEx}%
  \DidactaNewTheorem{question}{\didactaQuestionName}{didactaQues}%
  \DidactaNewTheorem{remark}{\didactaRemarkName}{didactaRem}%
  \DidactaNewTheorem{axiom}{\didactaAxiomName}{didactaAxiom}%
  \DidactaNewTheorem{algorithm}{\didactaAlgorithmName}{didactaAlgo}%
  \DidactaNewTheorem{notation}{\didactaNotationName}{didactaRem}%
}

%% ---------------------------------------------------------------------------
%% Legacy aliases
%%
%% The migrated material uses `ndefn`/`nthrm`/... for boxed and
%% `defn`/`thrm`/... for plain. Both map onto the same Didacta environment,
%% because Didacta decides the look from the medium rather than the name.
%% Migration is then a rename, not a re-author.
%% ---------------------------------------------------------------------------

\newcommand{\DidactaDeclareLegacyAliases}{%
  \didacta@alias{ndefn}{definition}%
  \didacta@alias{nthrm}{theorem}%
  \didacta@alias{nthm}{theorem}%
  \didacta@alias{nprop}{proposition}%
  \didacta@alias{npro}{property}%
  \didacta@alias{nlem}{lemma}%
  \didacta@alias{ncor}{corollary}%
  \didacta@alias{nex}{example}%
  \didacta@alias{nques}{question}%
  \didacta@alias{nrem}{remark}%
  \didacta@alias{naxioma}{axiom}%
  \didacta@alias{recipe}{algorithm}%
  \didacta@alias{defn}{definition}%
  \didacta@alias{thrm}{theorem}%
  \didacta@alias{prop}{proposition}%
  \didacta@alias{pro}{property}%
  \didacta@alias{lem}{lemma}%
  \didacta@alias{cor}{corollary}%
  \didacta@alias{ex}{example}%
  \didacta@alias{ques}{question}%
  \didacta@alias{rem}{remark}%
  \didacta@alias{axioma}{axiom}%
}

\newcommand{\didacta@alias}[2]{%
  \newenvironment{#1}[1][]{\begin{#2}[##1]}{\end{#2}}%
  \newenvironment{#1*}[1][]{\begin{#2*}[##1]}{\end{#2*}}%
}

%% ---------------------------------------------------------------------------
%% Proof
%%
%% amsthm's proof, with the name from the language file and a tinted rule so
%% it is skimmable in the notes. Proofs are the single largest thing that
%% belongs in the document and not on a slide, so a proof inside \onlynotes is
%% the common case; this makes it read well there.
%% ---------------------------------------------------------------------------

%% amsthm normally provides `proof`; with some class/option combinations it
%% does not, so declare or redeclare as needed rather than assuming.
\@ifundefined{proof}{\newenvironment{proof}}{\renewenvironment{proof}}[1][\didactaProofName]{%
  \par\addvspace{1.2ex}%
  \noindent{\itshape #1.}\ \ignorespaces
}{%
  \hfill$\square$\par\addvspace{1.2ex}%
}

%% ---------------------------------------------------------------------------
%% A highlighted formula
%%
%% For the one equation on the slide that matters.
%% ---------------------------------------------------------------------------

%% Esquinas redondeadas y el mismo grosor de marco que las cajas de teorema:
%% una fórmula destacada dentro de un ejemplo son dos cajas, una en otra, y
%% con radios distintos se ven como dos sistemas.
\newtcolorbox{didacta@formulabox}{
  enhanced,
  colback=didactaAccent!7, colframe=didactaAccent!60!black,
  boxrule=0.7pt, arc=3pt,
  left=1ex, right=1ex, top=0.8ex, bottom=0.8ex,
  before skip=1.6ex, after skip=1.6ex,
}
\newenvironment{keyformula}{%
  \begin{didacta@formulabox}\begin{equation*}
}{%
  \end{equation*}\end{didacta@formulabox}
}
%% Legacy name.
\newenvironment{nformula}{\begin{keyformula}}{\end{keyformula}}

%% ---------------------------------------------------------------------------
%% A statement singled out in a box
%%
%%   \begin{keypoint} ... \end{keypoint}
%%   \begin{keypoint}[Principio de inducción matemática] ... \end{keypoint}
%%
%% For what the student is given to work with and is not going to prove here:
%% the principle a whole section rests on, the convention everything below
%% assumes. The legacy material writes exactly this as
%% `\noindent\fbox{\begin{minipage}{\textwidth} ... \end{minipage}}`, and it
%% had nowhere to go: every Didacta environment either numbers and labels its
%% content --«Teorema 1.2»-- or is a formula.
%%
%% The environment is chosen by what the thing IS, not by how much of it is
%% shown: a theorem stated without its proof is still a theorem, and the
%% trigonometry appendix has three. What motivated this one is narrower -- the
%% principle of induction is not a theorem at all, because it is not derived
%% from anything: it is where the reasoning starts. A box says «retén esto»
%% without giving it a name it does not have.
%%
%% No counter and no label, on purpose. Con título, éste va en la misma
%% pestaña que llevan los teoremas --en tinta, no en color, porque esto no es
%% ninguno de ellos-- y sin título la caja va lisa. Lo que no puede pasar es
%% que un recuadro con nombre se componga distinto de los demás recuadros con
%% nombre de la misma página.
%% ---------------------------------------------------------------------------

%% La caja del medio que toque, en gris: así hereda la sombra en pantalla y la
%% discreción en papel sin repetir aquí ninguna medida. Sin título no hay
%% pestaña, y entonces sobra el hueco que se le reservaba arriba.
\newtcolorbox{didacta@pointbox}{
  didacta@box=didactaMuted,
  top=0.9ex,
}

\newtcolorbox{didacta@pointbox@titled}[1]{
  didacta@box=didactaMuted,
  title={#1},
}

%% Cuál de las dos cajas se ha abierto se recuerda en una macro, porque el
%% cierre del entorno ya no ve el argumento opcional.
\newcommand{\didacta@point@end}{}

\newenvironment{keypoint}[1][]{%
  \ifblank{#1}%
    {\let\didacta@point@end\didacta@point@end@plain
     \begin{didacta@pointbox}}%
    {\let\didacta@point@end\didacta@point@end@titled
     \begin{didacta@pointbox@titled}{#1}}%
  \ignorespaces
}{%
  \didacta@point@end
}

\newcommand{\didacta@point@end@plain}{\end{didacta@pointbox}}
\newcommand{\didacta@point@end@titled}{\end{didacta@pointbox@titled}}

\makeatother
\endinput
