\def\didactaRemarkName{Observaci\'o}
\def\didactaAxiomName{Axioma}
\def\didactaAlgorithmName{Algorisme}
\def\didactaNotationName{Notaci\'o}
\def\didactaProofName{Demostraci\'o}

%% Ejercicios.
\def\didactaExerciseName{Exercici}
\def\didactaAnswerName{Resposta}
\def\didactaSolutionName{Soluci\'o}
\def\didactaHintName{Pista}
\def\didactaMarkingName{Correcci\'o}
\def\didactaMarksName{punts}

%% Estructura y portada.
\def\didactaContentsName{Continguts}
\def\didactaChapterName{Cap\'itol}
