%%
%% didacta-lang-va.def -- Valencià.
%%
%% Uses babel's `catalan`, which is what the existing Valencian material does
%% and what produces correct hyphenation. The visible strings use Valencian
%% forms (Duració rather than Durada) where the two differ.
%%
\ProvidesFile{didacta-lang-va.def}[2026/09/09 Didacta Valencian]

\def\didactaBabelName{catalan}

\def\didactaTheoremName{Teorema}
\def\didactaDefinitionName{Definici\'o}
\def\didactaPropositionName{Proposici\'o}
\def\didactaLemmaName{Lema}
\def\didactaCorollaryName{Corol\textperiodcentered lari}
\def\didactaPropertyName{Propietat}
\def\didactaExampleName{Exemple}
\def\didactaQuestionName{Q\"uesti\'o}
\def\didactaRemarkName{Nota}
\def\didactaAxiomName{Axioma}
\def\didactaAlgorithmName{Algoritme}
\def\didactaNotationName{Notaci\'o}
\def\didactaProofName{Demostraci\'o}

\def\didactaExerciseName{Exercici}
\def\didactaAnswerName{Resposta}
\def\didactaSolutionName{Soluci\'o}
\def\didactaHintName{Indicaci\'o}
\def\didactaMarkingName{Correcci\'o}
\def\didactaMarksName{punts}

\def\didactaContentsName{Continguts}
\def\didactaChapterName{Tema}
\def\didactaSectionName{Apartat}
\def\didactaCourseName{Assignatura}
\def\didactaTeacherName{Professor}
\def\didactaAcademicYearName{Curs}
\def\didactaBibliographyName{Bibliografia}
\def\didactaObjectivesName{Objectius}
\def\didactaPrerequisitesName{Prerequisits}
\def\didactaSummaryName{Resum}
\def\didactaFurtherReadingName{Per a saber-ne m\'es}

\def\didactaTeachingNoteName{Nota did\`actica}
\def\didactaTimingName{Duraci\'o estimada}
\def\didactaCommonMistakeName{Error freq\"uent}

\def\didactaExamName{Examen}
\def\didactaDurationName{Duraci\'o}
\def\didactaTotalMarksName{Puntuaci\'o total}

%% Cómo se escriben en este idioma las funciones que el castellano llama
%% \sen, \tg, \arcsen, \arctg, \cotg, \cosec, \senh y \tgh. Ver
%% `didacta.sty`: existen en todos los idiomas para que una traducción que
%% copia las fórmulas tal cual compile, y aquí se decide cómo se leen.
\def\didactaSineName{sin}
\def\didactaTangentName{tg}
\def\didactaArcSineName{arcsin}
\def\didactaArcTangentName{arctg}
\def\didactaCotangentName{cotg}
\def\didactaCosecantName{cosec}
\def\didactaSinhName{sinh}
\def\didactaTanhName{tgh}
\endinput
