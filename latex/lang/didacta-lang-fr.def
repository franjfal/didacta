\def\didactaRemarkName{Remarque}
\def\didactaAxiomName{Axiome}
\def\didactaAlgorithmName{Algorithme}
\def\didactaNotationName{Notation}
\def\didactaProofName{D\'emonstration}

%% Ejercicios.
\def\didactaExerciseName{Exercice}
\def\didactaAnswerName{R\'eponse}
\def\didactaSolutionName{Solution}
\def\didactaHintName{Indication}
\def\didactaMarkingName{Bar\`eme}
\def\didactaMarksName{points}

%% Estructura y portada.
\def\didactaContentsName{Table des mati\`eres}
\def\didactaChapterName{Chapitre}
\def\didactaCourseName{Cours}
\def\didactaTeacherName{Enseignant}
\def\didactaAcademicYearName{Ann\'ee universitaire}
\def\didactaBibliographyName{Bibliographie}
\def\didactaObjectivesName{Objectifs}
\def\didactaPrerequisitesName{Pr\'erequis}
\def\didactaSummaryName{R\'esum\'e}
\def\didactaFurtherReadingName{Pour aller plus loin}

%% Canal del profesor.
\def\didactaTeachingNoteName{Note p\'edagogique}
\def\didactaTimingName{Dur\'ee estim\'ee}
