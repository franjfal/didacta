\def\didactaProofName{Dimostrazione}

%% Ejercicios.
\def\didactaExerciseName{Esercizio}
\def\didactaAnswerName{Risposta}
\def\didactaSolutionName{Soluzione}
\def\didactaHintName{Suggerimento}
\def\didactaMarkingName{Valutazione}
\def\didactaMarksName{punti}

%% Estructura y portada.
\def\didactaContentsName{Indice}
\def\didactaChapterName{Capitolo}
\def\didactaSectionName{Sezione}
\def\didactaCourseName{Insegnamento}
