%% didacta-legacy, que solo rellena lo que nadie haya definido.
\RequirePackage{didacta-bibliography}
%% Last, so anything above wins: this only fills in what the old
%% templates defined and the migrated material still expects.
\RequirePackage{didacta-legacy}

\DidactaDeclareTheorems
\DidactaDeclareLegacyAliases

%% These two toggles live in didacta-problems, so they can only be set once it
%% has been loaded.
\iftoggle{didacta@exam}{\toggletrue{didacta@examlayout}}{}
%% Hints follow the exam layout: wanted on a practice sheet, wrong on a paper.
\iftoggle{didacta@exam}{\togglefalse{didacta@hints}}{\toggletrue{didacta@hints}}

%% ---------------------------------------------------------------------------
%% Course metadata
%%
%% Declared once per course and read by the title page, the running heads and
%% the index. The legacy system spread this over \def\class, \def\classlong,
%% \def\classextralong, \def\sec, \def\dateshort and \def\code in a LaTeX file
%% that had to be \import-ed with a relative path; here it is one command with
%% named keys, and the engine can also inject it from course.yaml.
%% ---------------------------------------------------------------------------

\define@key{didacta@course}{title}{\def\didactaCourseTitle{#1}}
\define@key{didacta@course}{subtitle}{\def\didactaCourseSubtitle{#1}}
\define@key{didacta@course}{code}{\def\didactaCourseCode{#1}}
\define@key{didacta@course}{degree}{\def\didactaCourseDegree{#1}}
\define@key{didacta@course}{group}{\def\didactaCourseGroup{#1}}
\define@key{didacta@course}{teacher}{\def\didactaCourseTeacher{#1}}
\define@key{didacta@course}{year}{\def\didactaCourseYear{#1}}
\define@key{didacta@course}{institution}{\def\didactaCourseInstitution{#1}}
\define@key{didacta@course}{department}{\def\didactaCourseDepartment{#1}}
\define@key{didacta@course}{logo}{\def\didactaCourseLogo{#1}}

\def\didactaCourseTitle{}
\def\didactaCourseSubtitle{}
\def\didactaCourseCode{}
\def\didactaCourseDegree{}
\def\didactaCourseGroup{}
\def\didactaCourseTeacher{}
\def\didactaCourseYear{}
\def\didactaCourseInstitution{}
\def\didactaCourseDepartment{}
\def\didactaCourseLogo{}

\newcommand{\DidactaCourse}[1]{\setkeys{didacta@course}{#1}}

%% The unit or chapter this document is. Also names the output PDF, which is
%% what replaces the legacy chapterName.txt.
\def\didactaDocumentTitle{}
\newcommand{\DidactaDocument}[1]{\def\didactaDocumentTitle{#1}}

%% ---------------------------------------------------------------------------
%% Legacy metadata names
%%
%% Migrated content builds its own page headers out of the macros the old
%% preamble defined -- `\raisebox{-0.10cm}{Instructor: \profesor}` and friends
%% appear in handouts across the library. Didacta holds every one of those
%% values already, in the language being built, so the old names are defined
%% here rather than edited out of the content. Same reasoning as \onlybook and
%% ndefn: migrating is a move, not a rewrite.
%%
%% \providecommand, so a document that defines its own keeps it.
%%
%% Deliberately not defined, because Didacta has nothing to fill them with:
%% \texpath, \nohyphens, \documentclassname, \documentclassoptions. Those were
%% about how the legacy build found and configured its files, and the migration
%% reports them instead.
%% ---------------------------------------------------------------------------

\providecommand{\profesor}{\didactaCourseTeacher}
\providecommand{\professor}{\didactaCourseTeacher}
%% `\class` was the short course title and `\classlong` the full one; Didacta
%% keeps one title, so both point at it.
\providecommand{\class}{\didactaCourseTitle}
\providecommand{\classlong}{\didactaCourseTitle}
\providecommand{\classshort}{\didactaCourseTitle}
\providecommand{\classextralong}{%
  \didactaCourseTitle
  \ifdefempty{\didactaCourseDegree}{}{\newline(\didactaCourseDegree)}}
%% Not `\sec`: that is LaTeX's secant, and the old templates redefined
%% it as the group. The material uses it both ways -- 98 times as the
%% secant, 58 as the group -- so the maths wins and the migration
%% reports the header uses instead. \didactaCourseGroup is the group.
\providecommand{\dateshort}{\didactaCourseYear}
\providecommand{\code}{\didactaCourseCode}
\providecommand{\institute}{\didactaCourseInstitution}
\providecommand{\department}{\didactaCourseDepartment}
%% The legacy `chapterName.txt` / `\chapterTitle` pair is the document title.
\providecommand{\chapterTitle}{\didactaDocumentTitle}
\providecommand{\chapterName}{\didactaDocumentTitle}

%% ---------------------------------------------------------------------------
%% Injected metadata
%%
%% When the engine drives the build it knows the course and the document title
%% in the language being built, from course.yaml and year.yaml. It writes them
%% to a file in the build directory and points \DidactaInjectFile at it.
%%
%% Applied \AtBeginDocument, so it lands after the document's own
%% \DidactaCourse in the preamble and therefore wins. That ordering is the
%% point: the values in the .tex are a fallback that keeps a direct
%% `pdflatex master.tex` working in an editor, and the structure files are the
%% authority when Didacta builds. Without it the metadata has to be written
%% twice and the two drift -- which is how a Valencian header ends up on a
%% Castilian sheet.
%%
%% Never written into the content repository: the file lives in the build
%% output, which is disposable.
%% ---------------------------------------------------------------------------

\AtBeginDocument{%
  \@ifundefined{DidactaInjectFile}{}{%
    \IfFileExists{\DidactaInjectFile}{\input{\DidactaInjectFile}}{%
      \PackageWarning{didacta}{Injected metadata file not found:
        \DidactaInjectFile}}%
  }%
}

%% ---------------------------------------------------------------------------
%% Sections of a composition, in every language
%%
%%   \DidactaSection{es={Los números naturales},
%%                   va={Els nombres naturals},
%%                   en={The natural numbers}}
%%
%% A composition is the one place where prose lives outside a unit: the titles
%% of its sections. Writing them with a plain \section means they stay in one
%% language, and the Valencian build of a document comes out with Castilian
%% headings over Valencian content -- which is exactly the kind of half
%% translation that makes a document unusable in a classroom.
%%
%% Named keys rather than three positional arguments: a composition is read and
%% edited by hand, and `{...}{...}{...}` with three titles in it is unreadable
%% and silently wrong the day the order changes.
%%
%% A language that is not given falls back to the reference language rather
%% than printing nothing -- a missing heading would silently merge two sections
%% into one -- and says so in the log.
%% ---------------------------------------------------------------------------

%% Los idiomas a los que se puede dar título de sección. Tiene que decir lo
%% mismo que `LANGUAGE_REGISTRY` en engine/didacta/profiles.py, y
%% tests/test_languages.py lo comprueba: una composición que da un título en
%% un idioma que esto no nombra se compila con el título de otro y nadie lo ve.
\def\didacta@langs{es,va,ca,gl,eu,en,fr,de,it,pt}

\newcommand{\didacta@sectionkey}[1]{%
  \define@key{didacta@section}{#1}{\@namedef{didacta@sec@#1}{##1}}%
}
\@for\didacta@lang:=\didacta@langs\do{%
  \expandafter\didacta@sectionkey\expandafter{\didacta@lang}%
}

%% `\csname` define lo que no existía como `\relax`, no como vacío. Sin esta
%% línea, pedir un idioma para el que la composición no da título deja
%% `\didacta@sec@now` valiendo `\relax`, la comprobación de abajo no salta, y
%% el nombre de la macro --con arroba dentro-- se escribe tal cual en el
%% `.toc`. La compilación muere al releerlo, hablando de una secuencia no
%% definida que no aparece en ningún fichero del curso.
\newcommand{\didacta@sec@use}[1]{%
  \expandafter\let\expandafter\didacta@sec@now\csname didacta@sec@#1\endcsname
  \ifx\didacta@sec@now\relax \let\didacta@sec@now\@empty \fi}

\newcommand{\DidactaSection}[1]{%
  \@for\didacta@lang:=\didacta@langs\do{%
    \expandafter\let\csname didacta@sec@\didacta@lang\endcsname\@empty
  }%
  \setkeys{didacta@section}{#1}%
  \didacta@sec@use{\DidactaLanguage}%
  \ifx\didacta@sec@now\@empty
    \PackageWarning{didacta}{No `\DidactaLanguage' title for this section;
      using another language}%
    \@for\didacta@lang:=\didacta@langs\do{%
      \ifx\didacta@sec@now\@empty \didacta@sec@use{\didacta@lang}\fi
    }%
  \fi
  \section{\didacta@sec@now}%
}

%% ---------------------------------------------------------------------------
%% Including content
%%
%%   \DidactaUnit{analysis/normed-spaces/definition}     from content/
%%   \DidactaProblem{analysis/normed-spaces/norm-axioms} from problems/
%%
%% A reference is a path inside the content repository's own tree, resolved
%% against \DidactaContentRoot -- the repository root, which the engine passes
%% in. So a composition never contains `../../../../`. Getting rid of those
%% chains is a concrete win over the legacy layout, where the same import had
%% to be written with four, five or six levels of `../` depending on where the
%% master happened to sit, and where moving a folder broke every one of them.
%%
%% The optional argument overrides the language for one unit, which is what
%% makes a bilingual handout possible without duplicating the composition:
%%
%%   \DidactaUnit[en]{analysis/normed-spaces/definition}
%%
%% `import` shifts the graphics path too, so a unit refers to its own figures
%% as `figures/x.pdf` and works wherever it is included from.
%% ---------------------------------------------------------------------------

\RequirePackage{import}

\@ifundefined{DidactaContentRoot}{\def\DidactaContentRoot{./}}{}

%% Where each kind of reference resolves. Named so a repository could rename
%% its trees in didacta.yaml without touching any composition.
\@ifundefined{DidactaContentDir}{\def\DidactaContentDir{content/}}{}
\@ifundefined{DidactaProblemDir}{\def\DidactaProblemDir{problems/}}{}

\newcommand{\DidactaUnit}[2][]{%
  \didacta@include@unit{\DidactaContentDir}{#2}{#1}}

\newcommand{\DidactaProblem}[2][]{%
  \didacta@include@unit{\DidactaProblemDir}{#2}{#1}}

\newcommand{\didacta@include@unit}[3]{%
  \begingroup
    \edef\didacta@unit@lang{\ifblank{#3}{\DidactaLanguage}{#3}}%
    \edef\didacta@unit@path{\DidactaContentRoot#1#2/}%
    \IfFileExists{\didacta@unit@path\didacta@unit@lang.tex}{%
      \subimport{\didacta@unit@path}{\didacta@unit@lang}%
    }{%
      %% Fall back to the reference language rather than showing a hole: a
      %% deck with one untranslated slide is far more useful than a deck with
      %% a gap, and the placeholder still says which language is missing.
      \didacta@unit@fallback{#1}{#2}{\didacta@unit@lang}%
    }%
  \endgroup
}

%% Try each language in turn, then give up visibly.
\newcommand{\didacta@unit@fallback}[3]{%
  \def\didacta@found{0}%
  \@for\didacta@try:={es,va,en}\do{%
    \if\didacta@found0
      \IfFileExists{\DidactaContentRoot#1#2/\didacta@try.tex}{%
        \PackageWarning{didacta}{%
          No `#3' version of `#2'; using `\didacta@try' instead}%
        \subimport{\DidactaContentRoot#1#2/}{\didacta@try}%
        \def\didacta@found{1}%
      }{}%
    \fi
  }%
  \if\didacta@found0
    \didacta@missingunit{#2}{#3}%
  \fi
}

%% A unit with no file in any language is reported in the PDF rather than
%% silently skipped. Silently skipping is how you end up standing in front of a
%% class with a hole in the deck.
\newcommand{\didacta@missingunit}[2]{%
  \PackageWarning{didacta}{No `#2' version of unit `#1'}%
  \iftoggle{didacta@slides}{%
    \begin{frame}[plain]
      \begin{center}\small\ttfamily
        [ missing: #1 (#2) ]
      \end{center}
    \end{frame}
  }{%
    \par\medskip\noindent
    \fbox{\parbox{0.9\linewidth}{\small\ttfamily [ missing: #1 (#2) ]}}%
    \par\medskip
  }%
}

%% Include a raw file rather than a unit directory. For material that has not
%% been split per language yet -- during a migration, that is most of it.
\newcommand{\DidactaInclude}[1]{%
  \IfFileExists{\DidactaContentRoot#1.tex}{%
    \didacta@splitpath{\DidactaContentRoot#1}%
  }{%
    \PackageWarning{didacta}{Missing file `#1'}%
  }%
}

%% Split `a/b/c` into `a/b/` and `c` for \subimport, so graphics paths follow.
\def\didacta@splitpath#1{\didacta@splitpath@i#1/\@nil{}}
\def\didacta@splitpath@i#1/#2\@nil#3{%
  \def\didacta@tmp{#2}%
  \ifx\didacta@tmp\@empty
    \subimport{#3}{#1}%
  \else
    \didacta@splitpath@i#2\@nil{#3#1/}%
  \fi
}

%% ---------------------------------------------------------------------------
%% Teaching notes
%%
%% The teacher channel, with a visible treatment so it is obvious which copy
%% you are holding.
%% ---------------------------------------------------------------------------

%% La misma caja con pestaña que un teorema, en el color del profesor. Antes
%% era una raya al margen, y en una copia del profesor --que es donde esto
%% sale-- quedaba como lo único de la página sin enmarcar.
\newtcolorbox{didacta@teacherbox}[1][]{
  didacta@box=didactaTeacher,
  fonttitle=\bfseries\small,
  title={\didactaTeachingNoteName\ifblank{#1}{}{: #1}},
}

\NewEnviron{teaching}[1][]{%
  \iftoggle{didacta@teacher}{%
    \begin{didacta@teacherbox}[#1]\small\BODY\end{didacta@teacherbox}%
  }{}%
}

%% How long a unit takes. Teacher copies only.
\newcommand{\timing}[1]{%
  \onlyteacher{\par\noindent{\small\itshape\didactaTimingName: #1}\par}}

%% A mistake students reliably make here.
\NewEnviron{commonmistake}{%
  \iftoggle{didacta@teacher}{%
    \begin{didacta@teacherbox}[\didactaCommonMistakeName]\small\BODY\end{didacta@teacherbox}%
  }{}%
}

%% ---------------------------------------------------------------------------
%% Learning design
%%
%% Objectives and prerequisites are content, not decoration: they are what
%% makes a unit reusable, because they say what it assumes and what it gives.
%% ---------------------------------------------------------------------------

\NewEnviron{objectives}{%
  \didacta@listblock{\didactaObjectivesName}{\BODY}}
\NewEnviron{prerequisites}{%
  \didacta@listblock{\didactaPrerequisitesName}{\BODY}}
\NewEnviron{summary}{%
  \didacta@listblock{\didactaSummaryName}{\BODY}}

\newcommand{\didacta@listblock}[2]{%
  \begin{tcolorbox}[
    didacta@box=didactaAccentDark,
    fonttitle=\bfseries\small, title={#1},
  ]\small #2\end{tcolorbox}%
}

%% ---------------------------------------------------------------------------
%% Highlighting
%% ---------------------------------------------------------------------------

%% A highlight. Uses \colorbox rather than soul's \hl so it survives inside
%% maths and across a line break, which is where soul gives up.
\newcommand{\hl}[1]{\colorbox{didactaAccent!25}{#1}}

%% A term being defined. Bold rather than italic: italic disappears at
%% projector size.
\newcommand{\keyterm}[1]{\textbf{#1}}

%% ---------------------------------------------------------------------------
%% Front matter
%% ---------------------------------------------------------------------------

\newcommand{\DidactaTitlePage}{%
  \iftoggle{didacta@slides}{\didacta@titlepage@slides}{\didacta@titlepage@doc}}

\newcommand{\DidactaContents}{%
  \iftoggle{didacta@slides}{%
    \begin{frame}\frametitle{\didactaContentsName}
      \setcounter{tocdepth}{2}\tableofcontents
    \end{frame}%
  }{%
    \renewcommand{\contentsname}{\didactaContentsName}%
    \tableofcontents\clearpage
  }%
}

%% ---------------------------------------------------------------------------
%% El preámbulo de la plantilla
%%
%% Lo último del paquete y por tanto lo último del preámbulo del documento:
%% así una plantilla puede redefinir lo que Didacta acaba de definir --los
%% márgenes, los colores, un entorno-- en lugar de que Didacta la pise. Para
%% eso está: es la parte de la cabecera que escribe quien enseña.
%%
%% El fichero se lee **con `@` de símbolo corriente**, no de letra: es código
%% de quien escribe el material y se lee con las reglas de un documento. De
%% ahí el baile de `\makeatother` alrededor del `\input` en vez de ponerlo
%% detrás del de abajo -- ahí `\@ifundefined` ya no existiría, y el error que
%% sale es una cascada ilegible dentro de tcolorbox.
%%
%% Nunca vive en el repositorio de contenido: el motor apunta aquí al `.tex`
%% de la plantilla, que está en `templates/` y se edita desde Ajustes.
\@ifundefined{DidactaPreamble}{}{%
  \IfFileExists{\DidactaPreamble}{%
    \makeatother
    \input{\DidactaPreamble}%
    \makeatletter
  }{%
    \PackageWarning{didacta}{Template preamble not found: \DidactaPreamble}%
  }%
}

\makeatother
\endinput
