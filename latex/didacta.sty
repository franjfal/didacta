%% templates -- lists inside a frame come out with no bullets at all. It is
%% worth having in prose, so it is loaded only for the document profiles.
\iftoggle{didacta@slides}{}{\RequirePackage{enumitem}}
\RequirePackage{csquotes}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usetikzlibrary{calc,patterns,intersections,shapes.callouts,decorations.pathmorphing,arrows.meta,positioning}
