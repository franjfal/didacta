%%
%% didacta.sty -- the Didacta teaching-content package.
%%
%%     \input{didacta-bootstrap}
%%     \usepackage{didacta}
%%
%% Reads the output profile chosen by the bootstrap, sets the behaviour axes,
%% loads the language, and provides everything a piece of teaching content
%% needs. A source file that uses only Didacta commands compiles to any of the
%% profiles in didacta-profiles.tex without change.
%%
%% Dependencies are CTAN only. The legacy system needed six non-CTAN .sty
%% files and a bundled font; nothing here is outside a standard TeX Live.
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{didacta}[2026/09/09 v1.0 Didacta teaching content]

\makeatletter

%% ---------------------------------------------------------------------------
%% Guard: the bootstrap must have run
%% ---------------------------------------------------------------------------

\@ifundefined{DidactaProfile}{%
  \PackageError{didacta}{%
    Missing \string\input{didacta-bootstrap}%
  }{%
    A Didacta document starts with \string\input{didacta-bootstrap}, which
    chooses the document class from the output profile. Add it as the first
    line, before \string\usepackage{didacta}.%
  }%
}{}

%% ---------------------------------------------------------------------------
%% Axes
%%
%% Parsed from the profile declaration into the toggles that didacta-formats
%% reads. Defaults are the conservative choice: prose, full detail, student,
%% no solutions.
%% ---------------------------------------------------------------------------

\RequirePackage{etoolbox}
\RequirePackage{keyval}
\RequirePackage[table]{xcolor}

\RequirePackage{didacta-formats}

\newtoggle{didacta@compact}
\newtoggle{didacta@exam}

\define@key{didacta@axis}{medium}{%
  \ifstrequal{#1}{slides}{\toggletrue{didacta@slides}}{\togglefalse{didacta@slides}}}
\define@key{didacta@axis}{detail}{%
  \ifstrequal{#1}{full}{\toggletrue{didacta@full}}{\togglefalse{didacta@full}}}
\define@key{didacta@axis}{audience}{%
  \ifstrequal{#1}{teacher}{\toggletrue{didacta@teacher}}{\togglefalse{didacta@teacher}}}
\define@key{didacta@axis}{solutions}{%
  \ifstrequal{#1}{full}{\toggletrue{didacta@answers}\toggletrue{didacta@solutions}}{%
    \ifstrequal{#1}{answers}{\toggletrue{didacta@answers}\togglefalse{didacta@solutions}}{%
      \togglefalse{didacta@answers}\togglefalse{didacta@solutions}}}}
\define@key{didacta@axis}{pauses}{%
  \ifstrequal{#1}{on}{\toggletrue{didacta@pauses}}{\togglefalse{didacta@pauses}}}
\define@key{didacta@axis}{layout}{%
  \ifstrequal{#1}{compact}{\toggletrue{didacta@compact}}{}%
  \ifstrequal{#1}{exam}{\toggletrue{didacta@exam}}{}}
%% Consumed by the bootstrap; accepted and ignored here.
\define@key{didacta@axis}{notes}{}

%% Defaults, then the profile's declaration on top.
\togglefalse{didacta@slides}
\toggletrue{didacta@full}
\togglefalse{didacta@teacher}
\togglefalse{didacta@answers}
\togglefalse{didacta@solutions}
\togglefalse{didacta@pauses}

\input{didacta-profiles}

%% Build the \setkeys call by expansion and then run it. A chain of
%% \expandafter around a literal family name and a macro value is easy to get
%% subtly wrong -- it was, and the symptom was an empty key rather than
%% anything that pointed at the cause.
\edef\didacta@axes@now{\@nameuse{didacta@profile@\DidactaProfile @axes}}
\edef\didacta@applyaxes{\noexpand\setkeys{didacta@axis}{\didacta@axes@now}}
\didacta@applyaxes

%% ---------------------------------------------------------------------------
%% Language
%% ---------------------------------------------------------------------------

\@ifundefined{DidactaLanguage}{\def\DidactaLanguage{es}}{}

\IfFileExists{didacta-lang-\DidactaLanguage.def}{}{%
  \PackageError{didacta}{Unknown language `\DidactaLanguage'}{%
    Didacta ships es, va, ca, gl, eu, en, fr, de, it and pt.\MessageBreak
    Add lang/didacta-lang-XX.def for another.}%
}
\input{didacta-lang-\DidactaLanguage.def}

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\expandafter\RequirePackage\expandafter[\didactaBabelName]{babel}

%% ---------------------------------------------------------------------------
%% Medium setup
%%
%% `beamerarticle` is what lets one source be both: in a document profile it
%% makes \begin{frame}, \frametitle and \pause no-ops instead of errors. It is
%% the single most important line in this file.
%% ---------------------------------------------------------------------------

\iftoggle{didacta@slides}{%
  %% Slides: beamer is already the class.
  \RequirePackage{didacta-theme}
}{%
  %% `notheorems` matters: beamer and beamerarticle otherwise define their own
  %% theorem, definition, lemma, corollary, example and solution environments,
  %% which collide with Didacta's. Suppressing them leaves one set of names
  %% with one meaning.
  \RequirePackage[notheorems]{beamerarticle}
  \RequirePackage{didacta-page}
}

%% ---------------------------------------------------------------------------
