                % ("id", "family", "class", "solutions", "audience", "pause", "label")))
    for profile in all_profiles.values():
        print("  %s%-9s %-8s %-9s %-9s %-6s %s" % (
            pad(S.accent(profile.id) if S.enabled else profile.id, 21),
            profile.family,
            profile.document_class,
            profile.solutions,
            profile.audience,
            "yes" if profile.pauses else "no",
            profile.label,
        ))
    print()
