def cmd_translations(args):
    """What needs translating, in the order worth doing it.

    Ordered by how much the unit is used, because translating something that
    appears in four courses is worth more than something used once.
    """
    root, settings = load_repo(args)
    units, _ = repo_mod.scan_units(root, settings)
    courses, _ = repo_mod.scan_courses(root, settings)

    # How many documents reference each unit.
    usage = {}
    for course in courses.values():
        for year in course.years.values():
            for document in year.documents:
                for ref in document.unit_refs:
                    unit = repo_mod.resolve_unit_ref(ref, units, root)
                    if unit:
                        usage[unit.id] = usage.get(unit.id, 0) + 1

    rows = []
    for unit in units.values():
        statuses = unit.statuses()
        for code in settings.languages:
            status = statuses.get(code, "missing")
            if status in ("missing", "outdated", "draft"):
                rows.append((usage.get(unit.id, 0), unit, code, status))
    rows.sort(key=lambda r: (-r[0], r[1].relpath, r[2]))

    if args.json:
        print(json.dumps([
            {"unit": u.relpath, "id": u.id, "language": c,
             "status": s, "usedBy": n, "reference": u.reference}
            for n, u, c, s in rows
        ], indent=1, ensure_ascii=False))
        return 0

    if not rows:
        print(S.ok("every unit is translated into every language"))
        return 0

    print(S.bold("%d translation task(s)" % len(rows)))
    print(S.dim("ordered by how many documents use the unit"))
    print()
    print(S.dim("  %-5s %-5s %-8s %s" % ("used", "lang", "state", "unit")))
    for count, unit, code, status in rows[: args.limit]:
        print("  %s%-5s %s%s" % (
            pad(str(count) if count else S.dim("0"), 6),
            code,
            pad(status_text(status), 9),
            unit.relpath))
    if len(rows) > args.limit:
        print(S.dim("  ... and %d more" % (len(rows) - args.limit)))
    return 0


