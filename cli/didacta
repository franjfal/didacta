def cmd_units(args):
    root, settings = load_repo(args)
    units, errors = repo_mod.scan_units(root, settings)

    selected = list(units.values())
    if args.category:
        selected = [u for u in selected if u.category == args.category]
    if args.topic:
        selected = [u for u in selected if u.topic == args.topic]
    if args.tag:
        selected = [u for u in selected if args.tag in u.tags]
    if args.kind:
        selected = [u for u in selected if u.kind == args.kind]
    if args.search:
        needle = args.search.lower()
        selected = [
            u for u in selected
            if needle in u.id.lower()
            or any(needle in t.lower() for t in u.titles.values())
            or any(needle in t.lower() for t in u.tags)
        ]
    if args.missing:
        selected = [u for u in selected if args.missing in u.missing_languages]

    selected.sort(key=lambda u: u.relpath)

    if args.json:
        print(json.dumps([u.as_dict() for u in selected], indent=1, ensure_ascii=False))
        return 0

    if not selected:
        print(S.dim("no units match"))
        return 0

    print(S.dim("  %-8s %-6s %-6s %-6s %s" % ("kind", "es", "va", "en", "unit")))
    for unit in selected:
        statuses = unit.statuses()
        print("  %-8s %s%s%s%s" % (
            unit.kind,
            pad(status_text(statuses.get("es", "missing")), 7),
            pad(status_text(statuses.get("va", "missing")), 7),
            pad(status_text(statuses.get("en", "missing")), 7),
            unit.relpath,
        ))
        if args.verbose:
            print("         %s" % S.dim(unit.title(args.lang)))
            if unit.tags:
                print("         %s" % S.dim("tags: " + ", ".join(unit.tags)))
    print()
    print(S.dim("  %d unit(s)" % len(selected)))
    if errors:
        print(S.bad("  %d problem(s); run `didacta check`" % len(errors)))
    return 0


