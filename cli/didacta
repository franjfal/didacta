def cmd_migrate(args):
    """Import material from the legacy LaTeX system.

    Reads the old repository and writes a new content repository. The source is
    never modified, and nothing is written without --apply.
    """
    source = os.path.abspath(args.source)
    target = os.path.abspath(args.target)

    if not os.path.isdir(os.path.join(source, "00classnotes")):
        print(S.bad("%s does not look like the legacy repository" % source))
        print(S.dim("  expected a 00classnotes/ directory in it"))
        return 1
    if os.path.abspath(target) == os.path.abspath(source):
        print(S.bad("the target must be a different directory from the source"))
        return 1

    print(S.bold("reading %s" % source))
    plan = migrate_mod.plan_units(
        source, target, category=args.category, limit=args.limit)

    if plan.errors:
        for message in plan.errors:
            print(S.bad("error  ") + " " + message)
        return 2

    # The compositions: which units each legacy master selected, in order.
    # Planned even for a dry run, because the interesting question -- how much
    # of the old structure survives -- is answered here rather than by the
    # unit count.
    courses = None
    if not args.no_courses:
        courses = migrate_mod.plan_courses(
            source, target, plan.units, year=args.year)
        for message in courses.errors:
            print(S.bad("error  ") + " " + message)

    summary = plan.summary()
    print()
    print("  %-16s %d" % ("units", summary["units"]))
    print("  %-16s %d" % ("source files", summary["files"]))
    print("  %-16s %d" % ("skipped", summary["skipped"]))
    print()
    print(S.bold("  by kind"))
    for kind, count in sorted(summary["byKind"].items(), key=lambda kv: -kv[1]):
        print("    %-12s %d" % (kind, count))
    print()
    print(S.bold("  by languages present"))
    for combination, count in sorted(summary["byLanguages"].items(),
                                     key=lambda kv: -kv[1]):
        share = 100.0 * count / max(summary["units"], 1)
        print("    %-12s %5d  %5.1f%%" % (combination or "(none)", count, share))

    if courses is not None:
        totals = courses.summary()
        print()
        print(S.bold("  compositions"))
        print("    %-12s %d" % ("courses", totals["courses"]))
        print("    %-12s %d" % ("years", totals["years"]))
        print("    %-12s %d" % ("documents", totals["documents"]))
        print("    %-12s %d" % ("references", totals["references"]))
        if totals["unresolved"]:
            print(S.warn("    %-12s %d" % ("unresolved", totals["unresolved"])))

    if args.list:
        print()
        print(S.bold("  target layout"))
        for unit in plan.units[: args.show]:
            print("    %-58s %s" % (unit.relpath, "+".join(unit.languages)))
        if len(plan.units) > args.show:
            print(S.dim("    ... and %d more" % (len(plan.units) - args.show)))

    if not args.apply:
        print()
        print(S.warn("dry run: nothing written"))
        print(S.dim("  add --apply to create %s" % target))
        print(S.dim("  add --list to see the target layout"))
        return 0

    print()
    print(S.bold("writing %s" % target))
    written = []

    def report(unit, files):
        written.extend(files)
        if args.verbose:
            print("  %-58s %s" % (unit.relpath, "+".join(unit.languages)))

    created, problems = migrate_mod.apply_plan(plan, dry_run=False, on_unit=report)

    if courses is not None:
        course_files, course_problems = migrate_mod.apply_courses(
            courses, dry_run=False)
        created.extend(course_files)
        problems.extend(course_problems)

    print()
    print("%d file(s) written" % len(created))
    if problems:
        print(S.bad("%d problem(s):" % len(problems)))
        for message in problems[:10]:
            print("  " + message)

    failures = []
    if args.verify:
        failures = _verify(target, verbose=args.verbose)

    # The report is the deliverable of a migration, not the files: it says what
    # the legacy material could not tell us and therefore what still needs a
    # human.
    report_path = os.path.join(target, "MIGRATION-REPORT.md")
    with open(report_path, "w", encoding="utf-8") as handle:
        handle.write(_migration_report(plan, courses, source, target,
                                       failures))
    print()
    print(S.bold("report: ") + report_path)
    print(S.dim("  %d unit(s) need a decision" % len(plan.decisions)))
    if courses is not None and courses.decisions:
        print(S.dim("  %d document(s) need a decision" % len(courses.decisions)))
    print()
    print(S.dim("  next: cd %s && didacta check" % os.path.relpath(target)))
    return 0


#: A diagnostic looks like `error <file>:<line> <message>  <- <context>`.
_WHERE = re.compile(r"^error\s+(\S+?)(?::(\d+))?\s+(.*)$", re.S)


def _failure_section(failures):
    """The verify failures, grouped by the file at fault.

    Grouped because the same unit breaks several documents: measured on
    2025-2026, 19 documents fail from 11 distinct units, and one of them --
    the bibliography unit that uses biblatex `\cites` -- accounts for six.
    Listing documents asks the author to read one error six times; listing
    units says how much work there is, and which fix buys the most.
    """
    groups = {}
    for name, profile, message in failures:
        match = _WHERE.match(message.strip())
        if match:
            where = match.group(1)
            if match.group(2):
                where += ":" + match.group(2)
            detail = match.group(3)
        else:
            where, detail = "(sin localizar)", message
        entry = groups.setdefault(where, {"detail": detail, "documents": []})
        entry["documents"].append((name, profile))

    ordered = sorted(groups.items(),
                     key=lambda item: (-len(item[1]["documents"]), item[0]))

    lines = [
        "## Lo que no compila (%d unidad(es), %d documento(s))"
        % (len(groups), len(failures)),
        "",
        "Compilado un perfil de cada documento con `--verify`, y agrupado por el",
        "fichero que falla: la misma unidad rompe varios documentos, así que la",
        "cuenta que importa es la de unidades y el orden es por cuántos",
        "documentos arregla cada una.",
        "",
        "Casi nada de esto lo ha causado la migración. Son errores que ya",
        "estaban en el material — un `%` que se come un argumento obligatorio,",
        "un `tikzpicture` que desborda una dimensión, un paquete que cargaba el",
        "preámbulo antiguo — pero son justo los que no se encuentran leyendo los",
        "ficheros.",
        "",
    ]
    for where, entry in ordered:
        count = len(entry["documents"])
        lines.append("### `%s`" % where)
        lines.append("")
        lines.append("%s" % entry["detail"].strip()[:400])
        lines.append("")
        lines.append("Rompe %d documento(s):" % count)
        for name, profile in sorted(entry["documents"]):
            lines.append("- `%s` (`%s`)" % (name, profile))
        lines.append("")
    return lines


def _verify(target, verbose=False):
    """Compile one profile of every migrated document.

    One profile, not all fourteen: a document that fails does so in the first
    one, and the point is to name it rather than to measure it. The profile is
    the document's own default, so a problem sheet is built as a problem sheet.

    Returns ``[(document, profile, first error)]``.
    """
    settings = repo_mod.Settings.load(target)
    courses, errors = repo_mod.scan_courses(target, settings)
    if errors:
        for message in errors[:5]:
            print(S.bad("error  ") + " " + message)
        return []

    documents = [
        (course.id, year, document)
        for course in sorted(courses.values(), key=lambda item: item.id)
        for year, entry in sorted(course.years.items())
        for document in entry.documents
    ]
    if not documents:
        return []

    engine = build_mod.Engine(
        LATEX_DIR,
        os.path.join(target, settings.build_dir, ".verify"),
    )

    print()
    print(S.bold("verifying %d document(s)" % len(documents)))
    failures = []
    for index, (course_id, year, document) in enumerate(documents, 1):
        wanted = document.profiles or [
            profile.id for profile in
            profiles_mod.default_profiles(engine.profiles, document.kind)
        ]
        profile = wanted[0] if wanted else "notes"
        result = engine.build(
            document.source, profile, document.language,
            document_id=document.id,
            document_title=document.title(document.language),
            content_root=repo_mod.content_root_for(document.source, target),
        )
        if result.ok:
            if verbose:
                print("  ok    %s/%s/%s" % (course_id, year, document.id))
        else:
            first = str(result.errors[0]) if result.errors else "sin diagnóstico"
            failures.append(("%s/%s/%s" % (course_id, year, document.id),
                             profile, first))
            print(S.bad("  fail  ") + "%s/%s %s" % (course_id, document.id, profile))
        if not verbose and index % 25 == 0:
            print(S.dim("  ... %d/%d" % (index, len(documents))))

    print()
    print("%d of %d document(s) compile"
          % (len(documents) - len(failures), len(documents)))
    return failures


def _migration_report(plan, courses, source, target, failures=()):
    summary = plan.summary()
    lines = [
        "# Informe de migración",
        "",
        "Generado por `didacta migrate`. El repositorio de origen **no se ha",
        "modificado**: sigue compilando con sus propios Makefiles.",
        "",
        "| | |",
        "|---|---|",
        "| origen | `%s` |" % source,
        "| destino | `%s` |" % target,
        "| unidades | %d |" % summary["units"],
        "| ficheros de origen | %d |" % summary["files"],
        "| omitidos | %d |" % summary["skipped"],
        "",
        "## Idiomas presentes",
        "",
        "| idiomas | unidades | % |",
        "|---|---|---|",
    ]
    for combination, count in sorted(summary["byLanguages"].items(),
                                     key=lambda kv: -kv[1]):
        lines.append("| %s | %d | %.1f%% |" % (
            combination or "(ninguno)", count,
            100.0 * count / max(summary["units"], 1)))

    lines += [
        "",
        "## Qué se ha transformado automáticamente",
        "",
        "- se ha borrado el preámbulo de cada fichero (Didacta lo suministra);",
        "- los ficheros se han agrupado por unidad lógica y renombrados",
        "  `es.tex` / `va.tex` / `en.tex`;",
        "- `ndefn`, `defn`, `nthrm`, `ej`, … renombrados a los entornos de",
        "  Didacta;",
        "- `shownto{solution}` → `solution`, `shownto{profesor}` → `marking`;",
        "- `\\onlybook` → `\\onlynotes`, `\\pause` → `\\dpause`,",
        "  `\\frametitle` → `\\didactatitle`;",
        "- las figuras se han copiado junto a su unidad.",
        "",
        "## Qué necesita una decisión humana",
        "",
        "El material anterior no guardaba esta información en ninguna parte, así",
        "que la migración **no la ha inventado**. Cada `unit.yaml` lleva los",
        "campos correspondientes marcados con `TODO`.",
        "",
        "- **título por idioma** — se ha extraído del `\\frametitle` cuando",
        "  existía;",
        "- **etiquetas** — solo se ha derivado la carpeta del tema;",
        "- **prerrequisitos y objetivos** — vacíos;",
        "- **duración y dificultad** — vacíos.",
        "",
        "Todas las unidades llegan con estado `draft`: se han movido, no",
        "revisadas en el sistema nuevo.",
        "",
    ]

    flagged = plan.decisions
    if flagged:
        lines += [
            "## Unidades marcadas (%d)" % len(flagged),
            "",
        ]
        for unit in flagged[:200]:
            lines.append("### `%s`" % unit.relpath)
            lines.append("")
            for path in sorted(unit.sources.values()):
                lines.append("- origen: `%s`" % path)
            for decision in unit.needs_decision:
                lines.append("- **decidir:** %s" % decision)
            for note in unit.notes:
                lines.append("- nota: %s" % note)
            lines.append("")
        if len(flagged) > 200:
            lines.append("_… y %d unidades más._" % (len(flagged) - 200))
            lines.append("")

    if courses is not None:
        totals = courses.summary()
        lines += [
            "## Composiciones",
            "",
            "Cada documento del sistema anterior era un `.tex` con un preámbulo",
            "y una lista ordenada de `\\import{../../../../00classnotes/…}`. Lo",
            "que valía la pena de ese fichero era la lista, y ahora vive en",
            "`year.yaml`; el `.tex` que queda son dos líneas de arranque.",
            "",
            "| | |",
            "|---|---|",
            "| asignaturas | %d |" % totals["courses"],
            "| cursos académicos | %d |" % totals["years"],
            "| documentos | %d |" % totals["documents"],
            "| referencias a unidades | %d |" % totals["references"],
            "| referencias sin resolver | %d |" % totals["unresolved"],
            "",
            "Se han conservado como comentarios las referencias y los apartados",
            "que estaban comentados en el original: cada uno registra algo que",
            "se decidió dejar fuera ese curso.",
            "",
            "Lo que la migración **no** deduce y hay que decidir:",
            "",
            "- **el título en los demás idiomas** — el original solo tenía uno;",
            "- **los encabezados de apartado en los demás idiomas** — igual;",
            "- **qué perfiles compila cada documento** — por ahora se toman los",
            "  que corresponden a su tipo (`theory`, `problems`, `handout`,",
            "  `seminar`, `practical`, `exam`).",
            "",
        ]

        flagged_docs = courses.decisions
        if flagged_docs:
            lines += ["### Documentos marcados (%d)" % len(flagged_docs), ""]
            for document in flagged_docs[:120]:
                lines.append("#### `%s/%s/%s`" % (
                    document.course, document.year, document.id))
                lines.append("")
                lines.append("- origen: `%s`" % document.source)
                for decision in document.needs_decision:
                    lines.append("- **decidir:** %s" % decision)
                for note in document.notes:
                    lines.append("- nota: %s" % note)
                lines.append("")
            if len(flagged_docs) > 120:
                lines.append("_… y %d documentos más._" % (len(flagged_docs) - 120))
                lines.append("")

        if courses.skipped:
            lines += ["### Masters no colocados (%d)" % len(courses.skipped), ""]
            for path, why in courses.skipped[:40]:
                lines.append("- `%s` — %s" % (path, why))
            if len(courses.skipped) > 40:
                lines.append("- _… y %d más._" % (len(courses.skipped) - 40))
            lines.append("")

    if failures:
        lines += _failure_section(failures)

    if plan.skipped:
        lines += ["## Omitidos (%d)" % len(plan.skipped), ""]
        for path, why in plan.skipped[:60]:
            lines.append("- `%s` — %s" % (path, why))
        if len(plan.skipped) > 60:
            lines.append("- _… y %d más._" % (len(plan.skipped) - 60))
        lines.append("")

    lines += [
        "## Siguiente paso",
        "",
        "```bash",
        "cd %s" % target,
        "didacta check          # referencias, idiomas, prerrequisitos",
        "didacta units          # la biblioteca con su estado",
        "didacta translations   # qué falta traducir",
        "didacta build --all   # todo a PDF",
        "```",
        "",
    ]
    return "\n".join(lines)


