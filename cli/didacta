def collect_jobs(root, settings, args, all_profiles):
    """Work out what to build."""
    courses, _ = repo_mod.scan_courses(root, settings)

    documents = []
    for course in courses.values():
        for year in course.years.values():
            for document in year.documents:
                documents.append((course, year, document))

    if args.document:
        wanted = set(args.document)
        matched = [
            (c, y, d) for c, y, d in documents
            if d.id in wanted or "%s/%s" % (y.id, d.id) in wanted
        ]
        if not matched:
            print(S.bad("no document matches %s" % ", ".join(sorted(wanted))))
            print(S.dim("available: %s" % ", ".join(sorted(d.id for _, _, d in documents))))
            return None
        documents = matched
    elif not args.all:
        print(S.bad("name a document, or pass --all"))
        print(S.dim("available: %s" % ", ".join(sorted(d.id for _, _, d in documents))))
        return None

    if args.year:
        documents = [(c, y, d) for c, y, d in documents if y.year == args.year]
    if args.course:
        documents = [(c, y, d) for c, y, d in documents if c.id == args.course]

    jobs = []
    for course, year, document in documents:
        if not document.source:
            print(S.warn("  skipping %s: no %s.tex" % (document.id, document.id)))
            continue

        if args.profile:
            chosen = []
            for name in args.profile:
                if name not in all_profiles:
                    print(S.bad("unknown profile %r" % name))
                    print(S.dim("known: %s" % ", ".join(sorted(all_profiles))))
                    return None
                chosen.append(all_profiles[name])
        elif document.profiles:
            chosen = [all_profiles[p] for p in document.profiles if p in all_profiles]
        else:
            chosen = profiles_mod.default_profiles(all_profiles, document.kind)

        languages = args.language or [document.language or settings.default_language]

        content_root = repo_mod.content_root_for(document.source, root)
        for profile in chosen:
            for language in languages:
                jobs.append((
                    document.source,
                    profile,
                    language,
                    {
                        "document_id": "%s/%s" % (year.id, document.id),
                        "document_title": document.title(language),
                        "content_root": content_root,
                        # From course.yaml and year.yaml, in the language being
                        # built, so the .tex does not repeat it three times.
                        "course_keys": course.latex_course_keys(language, year.year),
                    },
                ))
    return jobs


def cmd_build(args):
    root, settings = load_repo(args)
    all_profiles = profiles_mod.load(LATEX_DIR)

    engine = build_mod.Engine(
        latex_dir=LATEX_DIR,
        build_dir=os.path.join(root, settings.build_dir),
        engine="pdflatex" if args.fast else "latexmk",
        verbose=args.verbose,
    )

    ready, why = engine.available()
    if not ready:
        print(S.bad("cannot build: %s" % why))
        print(S.dim("Didacta needs a TeX distribution with latexmk and pdflatex."))
        return 2

    jobs = collect_jobs(root, settings, args, all_profiles)
    if jobs is None:
        return 1
    if not jobs:
        print("nothing to build")
        return 0

    if args.list:
        print(S.bold("%d output(s) would be built" % len(jobs)))
        for source, profile, language, extra in jobs:
            print("  %-26s %-20s %s" % (extra["document_id"], profile.id, language))
        return 0

    print(S.bold("building %d output(s)" % len(jobs)))
    if args.fast:
        print(S.warn("  --fast: single pdflatex pass, so cross-references and the"))
        print(S.warn("  slide total may be wrong until a full build"))
    print()

    def report(result):
        mark = S.ok("ok  ") if result.ok else S.bad("FAIL")
        pages = "%3s pp" % result.pages if result.pages else "      "
        print("  %s%-30s %-20s %-3s %s %5.1fs" % (
            pad(mark, 6), result.document, result.profile,
            result.language, pages, result.seconds))
        if not result.ok:
            for diagnostic in result.errors[:4]:
                print("       %s" % S.bad(str(diagnostic)))
        elif args.verbose:
            for diagnostic in result.warnings[:3]:
                print("       %s" % S.warn(str(diagnostic)))

    results = engine.build_many(jobs, on_result=report)

    succeeded = [r for r in results if r.ok]
    failed = [r for r in results if not r.ok]

    print()
    print("%d succeeded, %d failed" % (len(succeeded), len(failed)))
    if succeeded:
        print(S.dim("  output: %s" % engine.build_dir))

    if args.json:
        summary = os.path.join(engine.build_dir, "summary.json")
        os.makedirs(engine.build_dir, exist_ok=True)
        with open(summary, "w", encoding="utf-8") as handle:
            json.dump([r.as_dict() for r in results], handle,
                      indent=1, ensure_ascii=False)
        print(S.dim("  summary: %s" % summary))

    return 1 if failed else 0


