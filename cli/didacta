def cmd_status(args):
    root, settings = load_repo(args)
    units, unit_errors = repo_mod.scan_units(root, settings)
    courses, course_errors = repo_mod.scan_courses(root, settings)
    all_profiles = profiles_mod.load(LATEX_DIR)

    print(S.bold(settings.name))
    print(S.dim(root))
    print()
    theory = [u for u in units.values() if not u.is_problem]
    problems = [u for u in units.values() if u.is_problem]
    documents = sum(len(y.documents) for c in courses.values() for y in c.years.values())

    print("  %-14s %d" % ("units", len(units)))
    print("  %-14s %d theory, %d problems" % ("", len(theory), len(problems)))
    print("  %-14s %d" % ("courses", len(courses)))
    print("  %-14s %d" % ("documents", documents))
    print("  %-14s %d" % ("profiles", len(all_profiles)))
    print("  %-14s %s" % ("languages", ", ".join(settings.languages)))

    # Translation coverage: the number that tells you where the work is.
    counts = {}
    for unit in units.values():
        for status in unit.statuses().values():
            counts[status] = counts.get(status, 0) + 1
    if counts:
        print()
        print(S.bold("  translation state"))
        for status in ("source", "reviewed", "translated", "draft", "outdated", "missing"):
            if status in counts:
                print("    %-10s %d" % (status, counts[status]))

    if courses:
        print()
        print(S.bold("  courses"))
        for course in courses.values():
            years = ", ".join(sorted(course.years)) or "-"
            print("    %-16s %-34s %s" % (course.id, course.title()[:34], years))

    problems_found = unit_errors + course_errors
    if problems_found:
        print()
        print(S.bad("  %d problem(s):" % len(problems_found)))
        for message in problems_found[:10]:
            print("    " + message)
    return 0


