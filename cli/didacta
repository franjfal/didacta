def supports_colour():
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


class Style:
    def __init__(self, enabled):
        self.enabled = enabled

    def _wrap(self, code, text):
        return "\033[%sm%s\033[0m" % (code, text) if self.enabled else text

    def bold(self, text):
        return self._wrap("1", text)

    def dim(self, text):
        return self._wrap("2", text)

    def ok(self, text):
        return self._wrap("32", text)

    def warn(self, text):
        return self._wrap("33", text)

    def bad(self, text):
        return self._wrap("31", text)

    def accent(self, text):
        return self._wrap("36", text)


S = Style(supports_colour())

STATUS_MARK = {
    "reviewed": "OK",
    "source": "src",
    "translated": "tr",
    "draft": "draft",
    "outdated": "STALE",
    "missing": "--",
}


def pad(text, width):
    """Left-pad to a visible width, ignoring ANSI escapes.

    `%-13s` counts the escape bytes, so a coloured column silently loses its
    alignment. This measures what the terminal actually shows.
    """
    import re as _re
    visible = len(_re.sub(r"\033\[[0-9;]*m", "", text))
    return text + " " * max(width - visible, 0)


def status_text(status):
    mark = STATUS_MARK.get(status, status)
    if status in ("reviewed", "source"):
        return S.ok(mark)
    if status in ("translated",):
        return mark
    if status in ("draft",):
        return S.warn(mark)
    if status == "outdated":
        return S.bad(mark)
    return S.dim(mark)


def load_repo(args):
    root = repo_mod.find_root(getattr(args, "root", None))
    settings = repo_mod.Settings.load(root)
    return root, settings


