def cmd_new_unit(args):
    root, settings = load_repo(args)
    area = repo_mod.PROBLEMS if args.kind == "problem" else repo_mod.CONTENT
    relpath = "%s/%s" % (area, args.path.strip("/"))
    directory = os.path.join(root, relpath)

    if os.path.isdir(directory) and os.listdir(directory):
        print(S.bad("%s already exists and is not empty" % relpath))
        return 1

    parts = args.path.strip("/").split("/")
    language = args.lang or settings.default_language
    title = args.title or parts[-1].replace("-", " ").capitalize()

    os.makedirs(directory, exist_ok=True)
    template = PROBLEM_TEMPLATE if args.kind == "problem" else UNIT_TEMPLATE
    with open(os.path.join(directory, "%s.tex" % language), "w", encoding="utf-8") as handle:
        handle.write(template.format(title=title))
    with open(os.path.join(directory, "unit.yaml"), "w", encoding="utf-8") as handle:
        handle.write(UNIT_META_TEMPLATE.format(
            title=title,
            identifier=".".join(parts) if area == repo_mod.CONTENT
                       else "problems." + ".".join(parts),
            kind=args.kind,
            language=language,
            category=parts[0] if len(parts) > 1 else "",
            topic=parts[1] if len(parts) > 2 else "",
        ))

    print(S.ok("created ") + relpath)
    print("  %s.tex" % language)
    print("  unit.yaml")
    return 0


def cmd_new_year(args):
    """Duplicate a course year.

    Copies structure, never content: the new year references the same units.
    That is the whole reason the split exists.
    """
    root, settings = load_repo(args)
    courses, _ = repo_mod.scan_courses(root, settings)

    course = courses.get(args.course)
    if course is None:
        print(S.bad("no course %r" % args.course))
        print(S.dim("known: %s" % ", ".join(sorted(courses))))
        return 1

    target = os.path.join(course.directory, args.year)
    if os.path.isdir(target):
        print(S.bad("%s/%s already exists" % (args.course, args.year)))
        return 1

    source_year = args.From or (sorted(course.years)[-1] if course.years else None)
    if source_year is None:
        print(S.bad("%s has no existing year to copy" % args.course))
        return 1
    if source_year not in course.years:
        print(S.bad("no year %r in %s" % (source_year, args.course)))
        return 1

    previous = course.years[source_year]
    os.makedirs(target)

    # The structure file, with the year updated.
    with open(os.path.join(previous.directory, "year.yaml"), encoding="utf-8") as handle:
        text = handle.read()
    text = text.replace("year: %s" % source_year, "year: %s" % args.year)
    with open(os.path.join(target, "year.yaml"), "w", encoding="utf-8") as handle:
        handle.write(text)

    # The compositions, with the year in any visible date updated.
    copied = []
    for document in previous.documents:
        if not document.source:
            continue
        with open(document.source, encoding="utf-8") as handle:
            body = handle.read()
        body = body.replace(source_year, args.year)
        body = body.replace(source_year.replace("-", "--"), args.year.replace("-", "--"))
        destination = os.path.join(target, "%s.tex" % document.id)
        with open(destination, "w", encoding="utf-8") as handle:
            handle.write(body)
        copied.append(document.id)

    print(S.ok("created ") + "%s/%s from %s" % (args.course, args.year, source_year))
    print("  year.yaml")
    for name in copied:
        print("  %s.tex" % name)
    print()
    print(S.dim("  Structure only: every unit is still referenced, not copied."))
    print(S.dim("  Edit year.yaml to change the selection or the order."))
