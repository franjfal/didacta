def cmd_preview(args):
    """Compile one unit on its own, in the profiles that suit it.

    The question this answers is the one asked while editing: «¿cómo queda
    esto?» -- this unit, now, as a slide and as prose -- without building the
    30-page tema around it.

    The wrapper document is generated into the build directory and not into
    the repository: the preamble is needed to compile and has no business
    being visible in the library.
    """
    root, settings = load_repo(args)
    all_profiles = profiles_mod.load(LATEX_DIR)

    units, _ = repo_mod.scan_units(root, settings)
    unit = _find_unit(units, args.unit)
    if unit is None:
        print(S.bad("no unit matches %r" % args.unit))
        print(S.dim("a reference looks like analysis/normed-spaces/definition"))
        return 1

    wanted = preview_mod.profiles_for(unit.kind, all_profiles)
    if args.profile:
        chosen = []
        for name in args.profile:
            if name not in all_profiles:
                print(S.bad("unknown profile %r" % name))
                print(S.dim("known: %s" % ", ".join(sorted(all_profiles))))
                return 1
            chosen.append(all_profiles[name])
        wanted = chosen

    languages = args.language or [unit.reference]

    engine = build_mod.Engine(
        latex_dir=LATEX_DIR,
        build_dir=os.path.join(root, settings.build_dir),
        engine="pdflatex" if args.fast else "latexmk",
        verbose=args.verbose,
    )

    reference = unit.reference_path
    title = (unit.titles.get(languages[0])
             or unit.titles.get(unit.reference)
             or unit.id)

    if args.status:
        # Every language of the repository, not just the ones asked for: the
        # question this answers is «what is already built», and an output in
        # a language nobody asked about is still built.
        report = preview_mod.status(
            engine, unit, wanted,
            args.language or sorted(settings.languages),
            title,
        )
        if args.json:
            json.dump(report, sys.stdout, indent=2, ensure_ascii=False)
            sys.stdout.write("\n")
            return 0
        print(S.bold("%s (%s)" % (unit.relpath, unit.kind)))
        for record in report["outputs"]:
            if not record["exists"]:
                mark = S.dim("--  ")
                note = S.dim("sin compilar")
            elif record["stale"]:
                mark = S.warn("old ")
                note = S.warn("el origen ha cambiado despues de compilar")
            else:
                mark = S.ok("ok  ")
                note = S.dim(_when(record["mtime"]))
            print("  %s%-22s %-3s %s" % (
                pad(mark, 6), record["profile"], record["language"], note))
        if report["sourceNewest"]:
            print()
            print(S.dim("lo mas reciente del origen: %s (%s)"
                        % (report["sourceNewest"],
                           _when(report["sourceMtime"]))))
        return 0

    if args.list:
        print(S.bold("%s (%s)" % (unit.relpath, unit.kind)))
        for profile in wanted:
            print("  %-20s %s" % (profile.id, profile.label))
        print()
        print(S.dim("languages available: %s"
                    % ", ".join(sorted(unit.languages))))
        return 0

    ready, why = engine.available()
    if not ready:
        if args.json:
            json.dump({"ok": False, "error": why, "results": []},
                      sys.stdout, indent=2)
            sys.stdout.write("\n")
            return 2
        print(S.bad("cannot build: %s" % why))
        return 2

    results = []
    for language in languages:
        for profile in wanted:
            result = preview_mod.build(
                engine, root, reference, profile, language,
                title=title, kind=unit.kind,
            )
            results.append(result)
            if not args.json:
                mark = S.ok("ok  ") if result.ok else S.bad("FAIL")
                print("  %s%-22s %-3s %s %5.1fs" % (
                    pad(mark, 6), result.profile, result.language,
                    "%3s pp" % result.pages if result.pages else "      ",
                    result.seconds))
                if not result.ok:
                    for diagnostic in result.errors[:4]:
                        print("       %s" % S.bad(str(diagnostic)))
                elif result.pdf:
                    print("       %s" % S.dim(result.pdf))

    if args.json:
        json.dump(
            {
                "ok": all(r.ok for r in results),
                "unit": unit.relpath,
                "reference": reference,
                "results": [r.as_dict() for r in results],
            },
            sys.stdout,
            indent=2,
            ensure_ascii=False,
        )
        sys.stdout.write("\n")
    return 0 if all(r.ok for r in results) else 1


def _when(stamp):
    """A timestamp as something readable, relative to now.

    Relative and not absolute: what matters about a compiled PDF is whether
    it is from a minute ago or from March, and a date makes the reader do that
    subtraction themselves.
    """
    if not stamp:
        return "nunca"
    seconds = max(0, time.time() - stamp)
    if seconds < 90:
        return "hace un momento"
    minutes = seconds / 60
    if minutes < 90:
        return "hace %d min" % round(minutes)
    hours = minutes / 60
    if hours < 36:
        return "hace %d h" % round(hours)
    return "hace %d dias" % round(hours / 24)


def _find_unit(units, wanted):
    """Accepts a reference, a repository path, or a unit id.

    Three spellings because three callers use three: a composition writes
    `analysis/normed/definition`, the interface holds
    `content/analysis/normed/definition`, and a person types whichever they
    have on the clipboard.
    """
    wanted = wanted.strip().strip("/")
    for unit in units.values():
        if wanted in (unit.relpath, unit.reference_path, unit.id):
            return unit
    # A path with the area on the front, matched against the reference.
    for area in ("content/", "problems/"):
        if wanted.startswith(area):
            trimmed = wanted[len(area):]
            for unit in units.values():
                if unit.reference_path == trimmed:
                    return unit
    return None


def cmd_tidy(args):
    """Remove the migration header from every unit source.

    A bulk edit of every tracked `.tex`, so it is a dry run by default. What
    it removes is the three comment lines the migrator used to write at the
    top of each file -- the provenance, which `unit.yaml` also records, and a
    line telling every file that Didacta supplies the preamble.

    It touches only a header it recognises at the very top of a file, and
    never a comment somebody wrote themselves.
    """
    root = repo_mod.find_root(args.root)
    result = tidy_mod.tidy(root, apply=args.apply)

    if args.json:
        json.dump(result.as_dict(), sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
        return 0

    if not result.changed:
        print("nothing to tidy: %d files already have no header"
              % result.unchanged)
        return 0

    print("%s %d of %d unit sources (%s)"
          % ("tidied" if args.apply else "would tidy",
             result.changed,
             result.changed + result.unchanged,
             _human_bytes(result.bytes_removed)))
    for path in result.paths[:8]:
        print("  " + path)
    if len(result.paths) > 8:
        print("  ... and %d more" % (len(result.paths) - 8))
    if not args.apply:
        print("\nnothing written. Add --apply.")
    return 0


def _human_bytes(count):
    if count < 1024:
        return "%d B" % count
    if count < 1024 * 1024:
        return "%.1f kB" % (count / 1024)
    return "%.1f MB" % (count / (1024 * 1024))


def cmd_index(args):
    """Generate the derived catalogues an interface reads.

    Derived data: `--check` verifies what is on disk matches the content
    without writing, which is what CI runs so a stale index is a failed build
    rather than something noticed months later.
    """
    root, settings = load_repo(args)
    data = index_mod.build(root, settings, latex_dir=LATEX_DIR)
    manifest = data[index_mod.MANIFEST]

    if args.json:
        print(index_mod.dumps(manifest), end="")
        return 0

    counts = manifest["counts"]
    print(S.bold(manifest["name"]))
    print()
    print("  %-16s %d" % ("units", counts["units"]))
    print("  %-16s %d" % ("courses", counts["courses"]))
    print("  %-16s %d" % ("documents", counts["documents"]))
    print("  %-16s %s" % ("content hash", manifest["contentHash"]))

    if manifest["errors"]:
        print()
        print(S.warn("  %d problem(s) while reading the repository:"
                     % len(manifest["errors"])))
        for message in manifest["errors"][:5]:
            print("    " + message)

    fresh = index_mod.unchanged(root, data)

    if args.check:
        print()
        if fresh:
            print(S.ok("index is up to date"))
            return 0
        print(S.bad("index is stale"))
        print(S.dim("  run `didacta index` to regenerate it"))
        return 1

    if fresh:
        print()
        print(S.dim("already up to date; nothing written"))
        return 0

    written = index_mod.write(root, data, dry_run=args.dry_run)
    print()
    if args.dry_run:
        print(S.warn("dry run: nothing written"))
    for name in written:
        print("  " + name)
    return 0


