# check
# --------------------------------------------------------------------------

def cmd_check(args):
    root, settings = load_repo(args)
    all_profiles = profiles_mod.load(LATEX_DIR)
    units, unit_errors = repo_mod.scan_units(root, settings)
    courses, course_errors = repo_mod.scan_courses(root, settings)

    errors = list(unit_errors) + list(course_errors)
    warnings = []
    for unit in units.values():
        for message in unit.warnings:
            warnings.append("%s: %s" % (unit.relpath, message))

    # Every composition reference must resolve. An unresolved reference is a
    # hole in a lecture that only shows up when you project it.
    for course in courses.values():
        for year in course.years.values():
            for document in year.documents:
                if not document.source:
                    errors.append(
                        "%s/%s: declared in year.yaml but %s.tex does not exist"
                        % (year.id, document.id, document.id)
                    )
                for ref in document.unit_refs:
                    if repo_mod.resolve_unit_ref(ref, units, root) is None:
                        errors.append(
                            "%s/%s: references `%s`, which does not exist"
                            % (year.id, document.id, ref)
                        )
                for name in document.profiles:
                    if name not in all_profiles:
                        errors.append(
                            "%s/%s: unknown profile `%s`" % (year.id, document.id, name)
                        )

    # A document that builds in a language none of its units have is a hole too.
    for course in courses.values():
        for year in course.years.values():
            for document in year.documents:
                language = document.language or settings.default_language
                for ref in document.unit_refs:
                    unit = repo_mod.resolve_unit_ref(ref, units, root)
                    if unit and language not in unit.available_languages:
                        warnings.append(
                            "%s/%s builds in `%s` but `%s` has no %s.tex"
                            % (year.id, document.id, language, unit.relpath, language)
                        )

    # Prerequisites must name real units.
    for unit in units.values():
        for prerequisite in unit.prerequisites:
            if prerequisite not in units and repo_mod.resolve_unit_ref(
                    prerequisite, units, root) is None:
                warnings.append(
                    "%s: prerequisite `%s` does not exist" % (unit.relpath, prerequisite)
                )

    for message in errors:
        print(S.bad("error  ") + " " + message)
    for message in warnings:
        print(S.warn("warning") + " " + message)

    print()
    if errors:
        print(S.bad("%d error(s), %d warning(s)" % (len(errors), len(warnings))))
        return 1
    if warnings:
        print(S.warn("%d warning(s)" % len(warnings)))
        return 0
    print(S.ok("repository is consistent"))
    return 0


