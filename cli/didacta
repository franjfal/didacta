def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="didacta",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--root", help="content repository root (default: auto-detect)")
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("status", help="what is in this repository")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("profiles", help="the output profiles available")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_profiles)

    p = sub.add_parser("units", help="the content library")
    p.add_argument("--category")
    p.add_argument("--topic")
    p.add_argument("--tag")
    p.add_argument("--kind", choices=repo_mod.UNIT_KINDS)
    p.add_argument("--search", metavar="TEXT")
    p.add_argument("--missing", metavar="LANG", choices=profiles_mod.LANGUAGES,
                   help="only units with no version in this language")
    p.add_argument("--lang", default="es", choices=profiles_mod.LANGUAGES)
    p.add_argument("--json", action="store_true")
    p.add_argument("-v", "--verbose", action="store_true")
    p.set_defaults(func=cmd_units)

    p = sub.add_parser("translations", help="what needs translating")
    p.add_argument("--limit", type=int, default=40)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_translations)

    p = sub.add_parser("build", help="compile documents to PDF")
    p.add_argument("document", nargs="*", help="document id, or omit with --all")
    p.add_argument("-p", "--profile", action="append",
                   help="output profile (repeatable; default: the document's own)")
    p.add_argument("-l", "--language", action="append", choices=profiles_mod.LANGUAGES,
                   help="language (repeatable; default: the document's own)")
    p.add_argument("--all", action="store_true", help="every document")
    p.add_argument("--course")
    p.add_argument("--year")
    p.add_argument("--list", action="store_true", help="show what would be built")
    p.add_argument("--fast", action="store_true",
                   help="one pdflatex pass; quick, but references may be wrong")
    p.add_argument("--json", action="store_true", help="write summary.json")
    p.add_argument("-v", "--verbose", action="store_true")
    p.set_defaults(func=cmd_build)

    p = sub.add_parser("check", help="validate the repository")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("remove", help="delete a subject or one of its years")
    remove_sub = p.add_subparsers(dest="what")

    q = remove_sub.add_parser("course", help="a whole subject, every year")
    q.add_argument("id")
    q.add_argument("--apply", action="store_true",
                   help="actually delete; without it this only says what would go")
    q.set_defaults(func=cmd_remove_course)

    q = remove_sub.add_parser("year", help="one year of a subject")
    q.add_argument("course")
    q.add_argument("year")
    q.add_argument("--apply", action="store_true",
                   help="actually delete; without it this only says what would go")
    q.set_defaults(func=cmd_remove_year)

    p = sub.add_parser("index", help="generate the derived catalogues")
    p.add_argument("--check", action="store_true",
                   help="fail if the index on disk is stale; writes nothing")
    p.add_argument("--dry-run", action="store_true",
                   help="say what would be written")
    p.add_argument("--json", action="store_true", help="print the manifest")
    p.set_defaults(func=cmd_index)

    p = sub.add_parser("preview", help="compile one unit on its own")
    p.add_argument("unit", help="a unit reference, or a path under content/")
    p.add_argument("-p", "--profile", action="append",
                   help="output profile (repeatable; default: what suits the kind)")
    p.add_argument("-l", "--language", action="append",
                   choices=sorted(profiles_mod.LANGUAGES),
                   help="language (repeatable; default: the unit's reference)")
    p.add_argument("--list", action="store_true",
                   help="show the profiles this unit can be built in")
    p.add_argument("--status", action="store_true",
                   help="say what is already built, and whether it is current")
    p.add_argument("--fast", action="store_true",
                   help="one pdflatex pass; quick, but references may be wrong")
    p.add_argument("--json", action="store_true",
                   help="write the results as JSON, for an interface to read")
    p.add_argument("-v", "--verbose", action="store_true")
    p.set_defaults(func=cmd_preview)

    p = sub.add_parser(
        "tidy", help="remove the migration header from the unit sources"
    )
    p.add_argument("--apply", action="store_true",
                   help="actually write; without it this is a dry run")
    p.add_argument("--json", action="store_true", help="print the summary")
    p.set_defaults(func=cmd_tidy)

    p = sub.add_parser("migrate", help="import from the legacy LaTeX system")
    p.add_argument("source", help="the legacy repository (contains 00classnotes/)")
    p.add_argument("target", help="the content repository to create")
    p.add_argument("--apply", action="store_true",
                   help="actually write; without it this is a dry run")
    p.add_argument("--category", help="migrate only this legacy category")
    p.add_argument("--year", metavar="YYYY-YYYY",
                   help="migrate compositions only for this academic year")
    p.add_argument("--no-courses", action="store_true",
                   help="migrate the content library but not the compositions")
    p.add_argument("--verify", action="store_true",
                   help="compile every migrated document and report what fails")
    p.add_argument("--limit", type=int, help="stop after N units")
    p.add_argument("--list", action="store_true", help="show the target layout")
    p.add_argument("--show", type=int, default=40, help="how many to list")
    p.add_argument("-v", "--verbose", action="store_true")
    p.set_defaults(func=cmd_migrate)

    p = sub.add_parser("new", help="scaffold content")
    new_sub = p.add_subparsers(dest="what")

    q = new_sub.add_parser("unit", help="a new unit")
    q.add_argument("path", help="category/topic/unit")
    q.add_argument("--kind", default="theory", choices=repo_mod.UNIT_KINDS)
    q.add_argument("--lang", choices=profiles_mod.LANGUAGES)
    q.add_argument("--title")
    q.set_defaults(func=cmd_new_unit)

    q = new_sub.add_parser("course", help="a new subject")
    q.add_argument("id", help="the subject's id, which is its directory name")
    q.add_argument("--from", dest="From", metavar="ID",
                   help="subject to copy the metadata from")
    q.add_argument("--title")
    q.add_argument("--lang", choices=profiles_mod.LANGUAGES)
    q.set_defaults(func=cmd_new_course)

    q = new_sub.add_parser("year", help="duplicate a course year")
    q.add_argument("course")
    q.add_argument("year")
    q.add_argument("--from", dest="From", metavar="YEAR",
                   help="year to copy (default: the most recent)")
    q.set_defaults(func=cmd_new_year)

    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 0

    try:
        return args.func(args)
    except (repo_mod.RepoError, profiles_mod.ProfileError,
            yamlio.YamlError, build_mod.BuildError) as exc:
        print(S.bad("error: ") + str(exc))
        return 2


if __name__ == "__main__":
    # Line-buffered even when redirected. `migrate --verify` and `build --all`
    # run for many minutes, and with the default block buffering `> log` shows
    # nothing at all until the process ends -- which looks exactly like a hang.
    try:
        sys.stdout.reconfigure(line_buffering=True)
        sys.stderr.reconfigure(line_buffering=True)
    except AttributeError:  # pragma: no cover - Python < 3.7
        pass
    sys.exit(main())
