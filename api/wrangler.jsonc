{
  // Didacta's authenticated edge. See src/index.ts for what it does and why.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "didacta-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",

  "observability": { "enabled": true },

  "vars": {
    // Not secrets: all of these are visible to anyone who can call the API,
    // and two of them are in the app's own build. The only secret is
    // GITHUB_TOKEN, set with `wrangler secret put`.
    "FIREBASE_PROJECT_ID": "didacta-uv",
    "CONTENT_OWNER": "franjfal",
    "CONTENT_REPO": "didacta_db",
    "CONTENT_BRANCH": "main",

    // Never `*`: this API answers with private material and accepts writes,
    // so a wildcard would let any page a signed-in user visits read their
    // repository. Add the deployed app's origin here.
    "ALLOWED_ORIGINS": "http://localhost:8765",

    // Firebase will happily mint a token for an unverified address, and an
    // unverified address is one anybody can claim.
    "REQUIRE_VERIFIED_EMAIL": "true"
  }
}
