# Build output from the example content repository and from the test suite.
# PDFs are generated from the sources next to them; committing them would mean
# storing the same information twice and letting the two disagree.
examples/*/.didacta-build/
tests/.build-outputs/

# Python caches.
**/__pycache__/
**/*.pyc

# Generated indices in the example repository. They are derived: regenerating
# gives the same bytes, so committing them would mean reviewing a diff that
# carries no decision. A real content repository may well commit its own, so
# that a GitHub Pages deployment has something to serve without a build step.
examples/*/generated/

# The app's build output and its Dart/Flutter caches.
app/build/
app/.dart_tool/
app/.flutter-plugins*

# Los artefactos de una compilación de publicación, hecha a mano en local.
# En el CI viven en el runner y se suben al release; aquí serían 200 MB de
# binarios que se regeneran con una orden.
dist/

# La web construida. Se genera; no se versiona.
web/site/
web/docs/img/app/

# Repositorios de contenido clonados al lado, y los guiones locales para
# compilar. Aquí no va material docente: este repositorio es la plataforma, es
# público, y unos apuntes commiteados por descuido no se desandan.
didacta_db*/
/build.command
/Compilar Didacta.app/
